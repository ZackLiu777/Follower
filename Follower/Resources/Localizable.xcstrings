    "3-5 posts per week is optimal. Consistency matters more than volume." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-5 posts per week is optimal. Consistency matters more than volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週3〜5回の投稿が最適です。量より継続が重要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周3-5篇帖子最佳。持续性比数量更重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
