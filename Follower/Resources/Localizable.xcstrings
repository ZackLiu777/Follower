    "premium.heatmapDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darker cells indicate higher engagement. Use this heatmap to schedule posts when your audience is most active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "濃いセルは高いエンゲージメントを示します。このヒートマップを使って、オーディエンスが最もアクティブな時間に投稿をスケジュールしましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色越深表示互动越高。使用此热力图在受众最活跃的时段安排发帖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色越深表示互動越高。使用此熱力圖在受眾最活躍的時段安排發文。"
          }
        }
      }
    },
