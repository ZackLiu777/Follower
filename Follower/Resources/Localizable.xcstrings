        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単一画像より2.3倍のエンゲージメント。印象的な1枚目で5-7枚のスライドを使いましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
